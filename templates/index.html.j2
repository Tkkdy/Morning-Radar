<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Morning Radar：可追溯的 AI、市场与开发者晨报">
  <title>Morning Radar · {{ brief.date }}</title>
  <link rel="stylesheet" href="{{ root_prefix }}assets/style.css">
</head>
<body>
  <header class="hero">
    <nav><a class="brand" href="{{ root_prefix }}index.html">Morning Radar</a><a href="{{ root_prefix }}archive.html">历史晨报</a></nav>
    <p class="eyebrow">{{ brief.date }} · {{ brief.timezone }}</p>
    <h1>少而重要，事实可追溯。</h1>
    <p class="lede">AI 科技、重点公司与开发者生态的每日信号。</p>
  </header>
  <main>
    {% include "sections.html.j2" %}
    {% if brief.direction_observation %}
    <section><h2>方向观察</h2><div class="observation">{{ brief.direction_observation }}</div></section>
    {% endif %}
    {% if brief.cognitive_extension %}
    <section><h2>认知延伸</h2><div class="observation">{{ brief.cognitive_extension }}</div></section>
    {% endif %}
    {% if brief.watch_next %}
    <section><h2>继续观察</h2><ul class="watch">{% for text in brief.watch_next %}<li>{{ text }}</li>{% endfor %}</ul></section>
    {% endif %}
  </main>
  <footer>市场数据仅供信息参考，不构成投资建议。生成于 {{ brief.generated_at }}。</footer>
</body>
</html>
