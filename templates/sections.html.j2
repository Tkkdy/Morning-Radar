{% set sections = [
  ("今日重点", brief.top_stories),
  ("市场与公司", brief.market_and_companies),
  ("AI 与开源", brief.ai_and_open_source),
  ("趋势雷达", brief.trend_radar),
  ("开发者讨论", brief.developer_discussions)
] %}
{% for heading, items in sections %}
{% if items %}
<section>
  <h2>{{ heading }}</h2>
  <div class="cards">
  {% for item in items %}
    {% include "brief_card.html.j2" %}
  {% endfor %}
  </div>
</section>
{% endif %}
{% endfor %}
