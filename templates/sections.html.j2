{% set sections = [
  ("今日重点", brief.top_stories),
  ("市场与公司", brief.market_and_companies),
  ("AI 与开源", brief.ai_and_open_source),
  ("趋势雷达", brief.trend_radar),
  ("开发者讨论", brief.developer_discussions)
] %}
{% for heading, items in sections %}
{% if items %}
<section>
  <h2>{{ heading }}</h2>
  <div class="cards">
  {% for item in items %}
    {% with compact = false %}{% include "brief_card.html.j2" %}{% endwith %}
  {% endfor %}
  </div>
</section>
{% endif %}
{% endfor %}
{% if brief.tendencies %}
<section class="tendencies">
  <h2>结构趋势</h2>
  <div class="cards">
  {% for tendency in brief.tendencies %}
    <article class="tendency-card">
      <p class="section-label">{{ tendency.standing }}{% if tendency.latest_update %} · {{ tendency.latest_update }}{% endif %}</p>
      <h3>{{ tendency.claim }}</h3>
      <p class="why"><strong>共同机制：</strong>{{ tendency.shared_mechanism }}</p>
      <p>{{ tendency.decision_rationale }}</p>
    </article>
  {% endfor %}
  </div>
</section>
{% endif %}
{% if brief.radar_signals %}
<section class="radar-signals">
  <h2>雷达信号 · 尚待验证</h2>
  <div class="cards">
  {% for signal in brief.radar_signals %}
    <article class="radar-signal">
      <p class="section-label">尚待验证</p>
      <h3>{{ signal.claim }}</h3>
      <p>{{ signal.why_notable }}</p>
      <p class="uncertainty"><strong>不确定性：</strong>{{ signal.uncertainty }}</p>
      {% if signal.missing_evidence %}<p><strong>还缺：</strong>{{ signal.missing_evidence | join("；") }}</p>{% endif %}
      <div class="sources">
      {% for ref in signal.support_refs %}<a href="{{ ref.url }}" rel="noopener noreferrer">{{ ref.url | hostname }}</a>{% endfor %}
      </div>
    </article>
  {% endfor %}
  </div>
</section>
{% endif %}
{% if brief.other_reading %}
<section class="other-reading">
  <h2>其他值得阅读</h2>
  <div class="cards compact-cards">
  {% for item in brief.other_reading %}
    {% with compact = true %}{% include "brief_card.html.j2" %}{% endwith %}
  {% endfor %}
  </div>
</section>
{% endif %}
