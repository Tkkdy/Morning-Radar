<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>历史晨报 · Morning Radar</title>
  <link rel="stylesheet" href="assets/style.css">
</head>
<body>
  <header class="hero compact">
    <nav><a class="brand" href="index.html">Morning Radar</a><a href="archive.html">历史晨报</a></nav>
    <h1>历史晨报</h1>
  </header>
  <main><section><div class="archive-list">
  {% for item in briefs %}
    {% set main_items = item.top_stories + item.market_and_companies + item.ai_and_open_source + item.trend_radar + item.developer_discussions %}
    {% set first_item = main_items | first %}
    <a href="briefs/{{ item.date }}.html">
      <span class="archive-date">{{ item.date }}</span>
      <span class="archive-title">{% if first_item %}{{ first_item.title }}{% else %}当日无主内容{% endif %}</span>
      <strong class="archive-count">{{ main_items|length }} 条主内容{% if item.other_reading %} · {{ item.other_reading|length }} 条延伸阅读{% endif %}</strong>
    </a>
  {% endfor %}
  </div></section></main>
</body>
</html>
