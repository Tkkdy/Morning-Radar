    "canonical_title": "Ollama v0.32.10-rc1 发布：调整 repeat_penalty 默认值并优化 NVFP4 MLX 模型性能",
    "category": "AI/ML",
    "credibility_score": 1.0,
    "entity_names": [
      "ollama",
