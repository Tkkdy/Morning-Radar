# Production AI provider selection. Defaults to deepseek when omitted.
AI_PROVIDER=deepseek

# DeepSeek production AI analysis
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# SenseNova Token Plan production AI analysis. The base URL has a documented default.
SENSENOVA_API_KEY=
SENSENOVA_MODEL=
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1

# Optional authenticated GitHub API access.
# GitHub Actions normally supplies GITHUB_TOKEN automatically.
GITHUB_TOKEN=

# Optional WeChat summary notification
WXPUSHER_APP_TOKEN=
WXPUSHER_UIDS=
PUBLIC_SITE_URL=
